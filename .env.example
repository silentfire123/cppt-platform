# Local demonstration only. Copy to .env. Never commit real credentials.
XUNTUI_STORAGE_BACKEND=sqlite
POSTGRES_DSN=
XUNTUI_RUNTIME_ROOT=./runtime
XUNTUI_ARTIFACT_ROOT=./artifacts
XUNTUI_DATASET_ROOT=./runtime/datasets
XUNTUI_DATABASE_PATH=./runtime/training.db
XUNTUI_MODELSCOPE_CACHE=./model-cache
XUNTUI_TRAINING_WORKDIR=./training-work
XUNTUI_BACKEND_HOST=127.0.0.1
XUNTUI_BACKEND_PORT=8010
XUNTUI_LOG_LEVEL=info
XUNTUI_CORS_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
XUNTUI_LOCAL_RUNTIME_ENABLED=false
XUNTUI_EVALUATION_ENABLED=false
XUNTUI_AUTH_MODE=disabled
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_INFERENCE_BASE_URL=
CPPT_DOCS_BACKEND_ORIGIN=http://127.0.0.1:8010
CONTROL_CENTER_URL=http://127.0.0.1:3100
CPPT_FRONTEND_URL=http://127.0.0.1:3100/
# Optional object storage. Empty for local demonstration.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=rag-assets
MINIO_SECURE=false
# Optional remote GPU provider. Real operations can incur charges.
YOUYUN_API_BASE_URL=https://api.compshare.cn
YOUYUN_PUBLIC_KEY=
YOUYUN_PRIVATE_KEY=
YOUYUN_REGION=
YOUYUN_ZONE=
YOUYUN_INSTANCE_MODE=uhost
YOUYUN_IMAGE_ID=
YOUYUN_TRAINING_IMAGE_ID=
YOUYUN_INFERENCE_IMAGE_ID=
YOUYUN_PUBLIC_MODEL_ROOTS=/models,/model
XUNTUI_REMOTE_LOG_FOLLOW_ENABLED=true
XUNTUI_YOUYUN_RETENTION_HOURS=6
XUNTUI_YOUYUN_RETENTION_CHECK_MINUTES=5
