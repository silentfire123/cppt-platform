# Copy to .env.production on the CPU server. Never commit the real file.
XUNTUI_STORAGE_BACKEND=postgres
POSTGRES_DSN=postgresql://cppt_platform_app:replace-me@postgres-host:5432/cppt_platform

MINIO_ENDPOINT=minio-host:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=rag-assets
MINIO_SECURE=false
MODEL_UPLOAD_USER=deployment-service

XUNTUI_CORS_ORIGINS=https://train.example.com
XUNTUI_LOG_LEVEL=info
XUNTUI_UID=1000
XUNTUI_GID=1000
XUNTUI_DEPLOY_DATA_ROOT=./deploy-data
XUNTUI_BACKEND_BIND=127.0.0.1
XUNTUI_FRONTEND_BIND=127.0.0.1
XUNTUI_INFERENCE_BIND=127.0.0.1
XUNTUI_BACKEND_HOST_PORT=8010
XUNTUI_INFERENCE_HOST_PORT=8011
XUNTUI_FRONTEND_HOST_PORT=3100

# Control Center OAuth2 client. Keep the session secret private and use a read-only apps DSN.
XUNTUI_AUTH_MODE=required
CONTROL_CENTER_URL=https://auth.example.com
OAUTH_AUTHORIZE_URL=https://auth.example.com/api/oauth/authorize
OAUTH_TOKEN_URL=https://auth.example.com/api/oauth/token
OAUTH_USERINFO_URL=https://auth.example.com/api/oauth/userinfo
OAUTH_CLIENT_KEY=cppt-platform
OAUTH_APPS_DSN=
OAUTH_REDIRECT_URI=https://train.example.com/
CPPT_FRONTEND_URL=https://train.example.com/
OAUTH_SESSION_SECRET=replace-with-at-least-32-byte-random-secret
OAUTH_SESSION_TTL_SECONDS=3600
OAUTH_STATE_TTL_SECONDS=600
OAUTH_HTTP_TIMEOUT_SECONDS=10
OAUTH_COOKIE_SECURE=true

XUNTUI_BACKEND_SHM_SIZE=2gb

# Frontend is built for same-origin reverse proxy by default.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_INFERENCE_BASE_URL=
NEXT_PUBLIC_AUTH_CALLBACK_URL=/api/auth/callback
CPPT_DOCS_BACKEND_ORIGIN=http://backend:8010

# Remote Youyun SSH connection diagnostics and readiness timeout.
YOUYUN_SSH_CONNECT_TIMEOUT_SECONDS=20
YOUYUN_SSH_READY_TIMEOUT_SECONDS=300
# 训练完成后保留实例的自动释放兜底：超过保留时长自动删除实例，避免持续计费。
# 对比请求会滑动续期保留窗口；设为更大值可延长人工对比时间。
XUNTUI_YOUYUN_RETENTION_HOURS=6
# 自动释放检查间隔（分钟）。
XUNTUI_YOUYUN_RETENTION_CHECK_MINUTES=5

# Training default: community LLaMA-Factory image. Keep inference image separate.
YOUYUN_TRAINING_IMAGE_ID=
# Default image for the inference create form. Leave empty to follow the
# provider's newest official vLLM image; set it only to pin one version.
YOUYUN_INFERENCE_IMAGE_ID=
# Pod/container mode is selected by its support zone. Keep uhost for legacy deployments.
YOUYUN_INSTANCE_MODE=uhost
YOUYUN_POD_ZONE=
YOUYUN_PUBLIC_MODEL_ROOTS=/models,/model
XUNTUI_REMOTE_VLLM_PYTHON=python3
# Production startup expects a prebuilt image with vLLM; enable only as a fallback.
XUNTUI_REMOTE_VLLM_INSTALL=0
XUNTUI_REMOTE_VLLM_PACKAGE=vllm

# Override these with registry-qualified immutable tags for your deployment.
XUNTUI_BACKEND_IMAGE=cppt-platform-backend:local
XUNTUI_FRONTEND_IMAGE=cppt-platform-frontend:local
# Model evaluation services. Keep API keys only in the server-side .env.production.
XUNTUI_EVALUATION_JUDGE_BASE_URL=
XUNTUI_EVALUATION_JUDGE_API_KEY=
XUNTUI_EVALUATION_JUDGE_MODEL=
XUNTUI_EVALUATION_EMBEDDING_BASE_URL=
XUNTUI_EVALUATION_EMBEDDING_API_KEY=
XUNTUI_EVALUATION_EMBEDDING_MODEL=

# Production executes models exclusively on Youyun instances.
XUNTUI_LOCAL_RUNTIME_ENABLED=false
XUNTUI_EVALUATION_ENABLED=false
XUNTUI_MODEL_CATALOG=youyun-public

# Remote logs: keep one lifecycle-owned SSH follower per remote run.
XUNTUI_REMOTE_LOG_FOLLOW_ENABLED=true
